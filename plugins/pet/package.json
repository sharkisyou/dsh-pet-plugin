{
  "name": "dsh-pet",
  "private": true,
  "version": "0.1.0",
  "description": "DSH 宠物插件：状态驱动悬浮宠物（Codex 宠物包兼容）",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "src/pet-format.js",
    "src/state-machine.js",
    "src/image-dims.js"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "debug": "node --inspect-brk=9229 scripts/debug-host.mjs",
    "pretest": "node scripts/build-client.mjs",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
